---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations } from '../../i18n/utils';
import { industries } from '../../data/industries';

const lang = 'de' as const;
const t = useTranslations(lang);

---

<BaseLayout
  lang={lang}
  title="UniFi Partner Schweiz — Netzwerklösungen für KMU"
  description="Digital Runners – Ihr Schweizer UniFi Partner für professionelle Netzwerklösungen, UniFi Network und UniFi Protect."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Digital Runners",
    "description": "Ihr Schweizer UniFi Partner für professionelle Netzwerklösungen, UniFi Network und UniFi Protect.",
    "url": "https://digital-runners.ch/de/",
    "email": "info@digital-runners.ch",
    "areaServed": {
      "@type": "Country",
      "name": "Switzerland"
    },
    "serviceType": ["Netzwerkplanung", "UniFi Installation", "IT-Support", "Videoüberwachung", "Zutrittskontrolle"],
    "knowsLanguage": ["de", "en"],
    "priceRange": "$$"
  })} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Digital Runners",
    "url": "https://digital-runners.ch",
    "inLanguage": ["de", "en"],
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://digital-runners.ch/de/blog/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <Hero lang={lang} />

  <!-- Services overview -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">{t('services.title')}</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">{t('services.subtitle')}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: 'Globe',    title: t('services.network.title'), desc: t('services.network.desc') },
          { icon: 'Camera',   title: t('services.protect.title'), desc: t('services.protect.desc') },
          { icon: 'Exit',     title: t('services.access.title'),  desc: t('services.access.desc') },
          { icon: 'Phone',    title: t('services.talk.title'),    desc: t('services.talk.desc') },
          { icon: 'Data',     title: t('services.drive.title'),   desc: t('services.drive.desc') },
          { icon: 'Settings', title: t('services.install.title'), desc: t('services.install.desc') },
          { icon: 'Help',     title: t('services.support.title'), desc: t('services.support.desc') },
        ].map(service => (
          <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow border border-slate-100">
            <div class="bg-cyan-50 rounded-lg p-3 w-fit mb-4">
              <Icon name={service.icon} class="h-6 w-6 text-cyan-600" />
            </div>
            <h3 class="font-semibold text-slate-900 mb-2">{service.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/de/leistungen" class="inline-flex items-center gap-2 text-cyan-600 font-semibold hover:text-cyan-700 transition-colors">
          Alle Leistungen ansehen
          <Icon name="ArrowRightMD" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Product highlight: Frequenzmessung -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-slate-900 to-blue-950 rounded-2xl overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center p-8 md:p-12">
          <div>
            <span class="inline-block bg-cyan-500/20 text-cyan-300 text-xs font-semibold px-3 py-1 rounded-full mb-4">Neu</span>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">KI-gestützte Frequenzmessung</h2>
            <p class="text-slate-300 leading-relaxed mb-6">
              Wissen, wie viele Kunden wirklich kommen. Besucherzählung mit UniFi Protect — ohne SaaS-Abos, ohne Vendor-Lock-in, ab CHF 25/Monat laufende Kosten.
            </p>
            <div class="flex flex-wrap gap-6 text-sm text-slate-400 mb-8">
              <div>
                <span class="block text-2xl font-extrabold text-cyan-400">0.—</span>
                Lizenzkosten
              </div>
              <div>
                <span class="block text-2xl font-extrabold text-cyan-400">>90%</span>
                Genauigkeit
              </div>
              <div>
                <span class="block text-2xl font-extrabold text-cyan-400">4 Wo</span>
                Go-Live
              </div>
            </div>
            <a href="/de/frequenzmessung" class="inline-flex items-center gap-2 bg-cyan-500 hover:bg-cyan-400 text-slate-900 font-semibold px-6 py-3 rounded-lg transition-colors">
              Mehr erfahren
              <Icon name="ArrowRightMD" class="h-4 w-4" />
            </a>
          </div>
          <div class="hidden md:flex flex-col gap-4">
            {[
              'Retail & Fachhandel — Kundenfrequenz an Ein- und Ausgängen messen',
              'Büros & Coworking — Tatsächliche Raumbelegung erfassen',
              'Gastronomie & Events — Kapazitäten datenbasiert planen',
            ].map(item => (
              <div class="flex items-start gap-3 bg-white/5 rounded-lg p-4">
                <Icon name="CheckBig" class="h-5 w-5 text-cyan-400 shrink-0 mt-0.5" />
                <span class="text-sm text-slate-300">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">{t('portfolio.title')}</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">{t('portfolio.subtitle')}</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-4">
        {industries.map(ind => (
          <a
            href={`/de/branchen/${ind.slug}`}
            class="flex flex-col items-center gap-3 bg-slate-50 rounded-xl p-5 border border-slate-100 hover:border-cyan-300 hover:bg-white transition-all text-center group"
          >
            <Icon name={ind.icon} class="h-7 w-7 text-cyan-600" />
            <span class="text-sm font-medium text-slate-700 group-hover:text-cyan-600 transition-colors">{ind.de.name}</span>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/de/referenzen" class="inline-flex items-center gap-2 text-cyan-600 font-semibold hover:text-cyan-700 transition-colors">
          Alle Branchen ansehen →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-cyan-500 py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
        Bereit für Ihr professionelles UniFi-Netzwerk?
      </h2>
      <p class="text-slate-800 mb-8 max-w-xl mx-auto">
        Kontaktieren Sie uns für ein unverbindliches Gespräch. Wir finden die optimale Lösung für Sie.
      </p>
      <a href="/de/kontakt" class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-700 text-white font-semibold px-8 py-4 rounded-lg transition-colors">
        Jetzt Kontakt aufnehmen
      </a>
    </div>
  </section>
</BaseLayout>
